      "type": "text",
      "x": 60,
      "y": 1324,
      "width": 900,
      "height": 28,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "text": "FIG. 3  \u2014  Cocktail Party Effect: Selective Attention and Confidence Gating",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FIG. 3  \u2014  Cocktail Party Effect: Selective Attention and Confidence Gating",
      "lineHeight": 1.35,
      "autoResize": true
    },
    {
      "id": "t00077",
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "version": 2,
      "versionNonce": 277747,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774220097921,
      "link": null,
      "locked": false,
      "seed": 146414,
      "index": "a00077",
      "type": "text",
      "x": 60,
      "y": 1356,
      "width": 900,
      "height": 50.550000000000004,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "text": "FIG. 3 illustrates the passive selective attention mechanism: six cognitive senses evaluate inbound content,\na confidence score gates the result into noise, tentative, or confirmed paths, and a dedicated anomaly\nbranch flags GlobalConstraint violations as potential prompt injection or goal hijacking.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FIG. 3 illustrates the passive selective attention mechanism: six cognitive senses evaluate inbound content,\na confidence score gates the result into noise, tentative, or confirmed paths, and a dedicated anomaly\nbranch flags GlobalConstraint violations as potential prompt injection or goal hijacking.",
      "lineHeight": 1.35,
      "autoResize": true
    },
