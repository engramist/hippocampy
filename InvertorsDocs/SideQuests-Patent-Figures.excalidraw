      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "text": "FIG. 7  \u2014  Synaptic Pruning, Hebbian Learning, and Long-Term Potentiation",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
