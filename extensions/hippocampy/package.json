{
  "name": "hippocampy",
  "version": "0.1.0",
  "description": "HippoCampy memory plugin for OpenClaw",
  "type": "module",
  "main": "src/index.ts",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "install": {
      "localPath": "extensions/hippocampy",
      "defaultChoice": "local"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  }
}
